{
    "Jinja expression": {
        "scope": "jinja-html",
        "prefix": "jj",
        "body": "{{ ${1} }}",
        "description": "Jinja2: wyświetlanie wartości"
    },
    "Jinja block": {
        "scope": "jinja-html",
        "prefix": "jb",
        "body": "{% ${1} %}",
        "description": "Jinja2: blok instrukcji"
    },
    "Jinja if": {
        "scope": "jinja-html",
        "prefix": "jif",
        "body": [
            "{% if ${1:condition} %}",
            "    $0",
            "{% endif %}"
        ],
        "description": "Jinja2: instrukcja if"
    },
    "Jinja for": {
        "scope": "jinja-html",
        "prefix": "jfor",
        "body": [
            "{% for ${1:item} in ${2:items} %}",
            "    $0",
            "{% endfor %}"
        ],
        "description": "Jinja2: pętla for"
    }
}